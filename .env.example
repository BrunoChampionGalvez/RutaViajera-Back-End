DB_NAME=db_name
DB_HOST=db_host
DB_PORT=db_port
DB_USERNAME=db_username
DB_PASSWORD=db_password

# Puerto donde corre el backend
PORT=3001

# URL base pública del backend (usada en callbacks OAuth)
API_URL=http://localhost:3001

# Orígenes permitidos para CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:3000
# Autenticación y sesiones
JWT_SECRET=tu_jwt_secret
SESSION_SECRET=tu_session_secret

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Correo saliente (Nodemailer con Gmail App Password)
MAIL=tu_correo@gmail.com
# PASS debe ser una App Password de Gmail (no tu contraseña normal). Crear en: Google Account > Security > 2-Step Verification > App Passwords
PASS=tu_app_password_de_16_caracteres
